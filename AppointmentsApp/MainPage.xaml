<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AppointmentsApp.Models"
             x:Class="AppointmentsApp.MainPage"
             Title="Appointments">
    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Label Text="Appointments" Style="{StaticResource Headline}" />

        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="Add appointment" Clicked="OnAddAppointmentClicked" />
            <Button Text="Archived appointments" Clicked="OnArchivedAppointmentsClicked" />
        </HorizontalStackLayout>

        <Grid Grid.Row="2">
            <CollectionView x:Name="AppointmentsList"
                            SelectionMode="Single"
                            SelectionChanged="OnAppointmentSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppointmentModel">
                        <Border Padding="16" Margin="0,0,0,10" Stroke="{StaticResource Gray200}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18" />
                                <Label Text="{Binding AppointmentDate, StringFormat='{0:dddd, MMMM d, yyyy}'}" />
                                <Label Text="{Binding AppointmentTime, StringFormat='{0:h:mm tt}'}" />
                                <Label Text="{Binding Details}" IsVisible="{Binding HasDetails}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="EmptyStateLabel"
                   Text="No appointments yet. Add an appointment to get started."
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />
        </Grid>
    </Grid>
</ContentPage>
