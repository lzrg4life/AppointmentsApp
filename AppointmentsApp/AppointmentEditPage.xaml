<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppointmentsApp.AppointmentEditPage"
             Title="Appointment">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="PageHeading" Text="Appointment" Style="{StaticResource Headline}" />

            <Label Text="Title" />
            <Entry x:Name="TitleEntry" Placeholder="e.g. Doctor appointment" MaxLength="200" />

            <Label Text="Date" />
            <DatePicker x:Name="DatePicker" />

            <Label Text="Time" />
            <TimePicker x:Name="TimePicker" />

            <Label Text="Details" />
            <Editor x:Name="DetailsEditor" AutoSize="TextChanges" HeightRequest="120" />

            <Button Text="Save appointment" Clicked="OnSaveClicked" />
            <Button x:Name="ArchiveButton"
                    Text="Archive appointment"
                    Clicked="OnArchiveClicked"
                    IsVisible="False"
                    BackgroundColor="{StaticResource Gray600}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
